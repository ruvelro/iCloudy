<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>iCloudy</string>
    <!-- Placeholder reverse-DNS id; override at build time with ICLOUDY_BUNDLE_ID once the real domain exists. -->
    <key>CFBundleIdentifier</key><string>dev.icloudy.desktop</string>
    <key>CFBundleName</key><string>iCloudy</string>
    <key>CFBundleDisplayName</key><string>iCloudy</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.5.0</string>
    <key>CFBundleVersion</key><string>2</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleDevelopmentRegion</key><string>es</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 ruvelro. Todas tus nubes, en una sola ventana del Mac.</string>
    <!-- Dropping files on the Dock icon only works when the app declares what it opens. Without this the Finder never
         highlights the icon and application(_:open:) is never called. Rank "None": iCloudy is not a file's editor. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Archivo o carpeta para subir</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>None</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.item</string>
                <string>public.folder</string>
            </array>
        </dict>
    </array>
    <!-- A NAS on the local network often serves WebDAV over plain HTTP with a name macOS cannot verify. This allows
         that, and only that: everything outside the local network still has to use TLS. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key><true/>
    </dict>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <!-- "Subir a iCloudy" in every app's Services menu. Handled in-process: no app extension, no App Group. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Subir a iCloudy</string></dict>
            <key>NSMessage</key><string>uploadToICloudy</string>
            <key>NSPortName</key><string>iCloudy</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.file-url</string>
                <string>NSStringPboardType</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
